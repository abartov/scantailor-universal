	cd /home/runner/work/scantailor-universal/scantailor-universal/_codeql_build_dir && $(MAKE) $(MAKESILENT) -f src/core/interaction/CMakeFiles/interaction.dir/build.make src/core/interaction/CMakeFiles/interaction.dir/interaction_autogen/mocs_compilation.cpp.i
.PHONY : interaction_autogen/mocs_compilation.cpp.i

interaction_autogen/mocs_compilation.s: interaction_autogen/mocs_compilation.cpp.s
.PHONY : interaction_autogen/mocs_compilation.s

# target to generate assembly for a file
interaction_autogen/mocs_compilation.cpp.s:
