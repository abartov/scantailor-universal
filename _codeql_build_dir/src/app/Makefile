settings/fancylineedit.cpp.i:
	cd /home/runner/work/scantailor-universal/scantailor-universal/_codeql_build_dir && $(MAKE) $(MAKESILENT) -f src/app/CMakeFiles/scantailor-universal.dir/build.make src/app/CMakeFiles/scantailor-universal.dir/settings/fancylineedit.cpp.i
.PHONY : settings/fancylineedit.cpp.i

settings/fancylineedit.s: settings/fancylineedit.cpp.s
.PHONY : settings/fancylineedit.s

# target to generate assembly for a file
settings/fancylineedit.cpp.s:
	cd /home/runner/work/scantailor-universal/scantailor-universal/_codeql_build_dir && $(MAKE) $(MAKESILENT) -f src/app/CMakeFiles/scantailor-universal.dir/build.make src/app/CMakeFiles/scantailor-universal.dir/settings/fancylineedit.cpp.s
.PHONY : settings/fancylineedit.cpp.s

